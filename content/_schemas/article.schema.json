{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://era-modding-guide.local/schemas/article.schema.json",
  "title": "ERA Modding Guide article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "slug",
    "status",
    "sourceRefs",
    "keywords",
    "questions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(docs|erm)\\.[a-z0-9.-]+$"
    },
    "kind": {
      "const": "article"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "previous": {
      "type": [
        "string",
        "null"
      ]
    },
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "sectionSources": { "type": "object" },
    "section": {
      "enum": [
        "docs",
        "erm"
      ]
    }
  }
}
