{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial navigation",
  "type": "object",
  "required": ["schemaVersion", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "labelKey", "items"],
        "properties": {
          "id": { "type": "string" },
          "labelKey": { "type": "string" },
          "items": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["labelKey", "slug"],
              "properties": {
                "labelKey": { "type": "string" },
                "slug": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}

